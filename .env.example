# AI Study Tutor environment template
#
# The application runs locally in demo mode without this file and without a
# paid service. Copy it only when you want to change the runtime or use Claude.
# The real .env file is ignored and must not be committed or zipped.
#
# Windows PowerShell:
#   Copy-Item .env.example .env

STUDY_TUTOR_MODE=demo
STUDY_TUTOR_STORAGE=sqlite
ANTHROPIC_API_KEY=your_anthropic_api_key_here
