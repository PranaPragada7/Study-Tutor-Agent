# AI Study Tutor environment template
#
# Copy this file to .env and replace the placeholder for live AI responses.
# The real .env file is ignored and must not be committed or zipped.
# Study Tutor requires a valid key for its live Claude assistant.
#
# Windows PowerShell:
#   Copy-Item .env.example .env

ANTHROPIC_API_KEY=your_anthropic_api_key_here
