# AI Study Tutor environment template
#
# Copy this file to .env and replace the placeholder with your real key.
# The real .env file is ignored and must not be committed or zipped.
#
# Windows PowerShell:
#   Copy-Item .env.example .env

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional offline fallback. Leave as 0 for live API mode.
# Set to 1 in your shell for offline mode:
#   $env:STUDY_TUTOR_OFFLINE_MODE="1"
STUDY_TUTOR_OFFLINE_MODE=0
